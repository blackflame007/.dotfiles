#!/usr/bin/env bash
# theme-set hook: GTK apps in the theme's colours. `bromigos theme set NAME` runs it
# (bromigOS core, hooks/theme-set.d) with the theme's name.
#
# The Wick's GTK theme is "Bromigos" (the dotfiles' ~/.local/share/themes/Bromigos);
# any other theme gets "Bromigos-NAME", built from its palette into ~/.themes by
# ~/.config/bromigos/gtk/build-gtk-theme.py --current (half a second). Switching the
# gtk-theme setting is what makes running GTK apps restyle. libadwaita apps take
# named colours from ~/.config/gtk-4.0/gtk.css; its import is pointed at the theme's
# libadwaita.css (they pick it up when they next start). Leaves gtk-theme alone when
# a non-Bromigos GTK theme is in use.
set -eu
name=${1:-${BROMIGOS_THEME:-wick}}
if [ "$name" = wick ]; then
    gtk=Bromigos
    adw=../../.local/share/themes/Bromigos/gtk-4.0/libadwaita.css
else
    python3 "$HOME/.config/bromigos/gtk/build-gtk-theme.py" --current >/dev/null
    gtk=Bromigos-$name
    adw=../../.themes/Bromigos-$name/gtk-4.0/libadwaita.css
fi
css=$HOME/.config/gtk-4.0/gtk.css
if [ -f "$css" ] && [ ! -L "$css" ] && grep -q 'libadwaita.css' "$css"; then
    sed -i "s|@import url(\"[^\"]*libadwaita.css\");|@import url(\"$adw\");|" "$css"
fi
command -v gsettings >/dev/null || exit 0
now=$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")
case $now in
    Bromigos | Bromigos-*) [ "$now" = "$gtk" ] || gsettings set org.gnome.desktop.interface gtk-theme "$gtk" ;;
esac
