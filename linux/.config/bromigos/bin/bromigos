#!/usr/bin/env python3
"""bromigos: one command for the bromigOS desktop.

  bromigos                         this help
  bromigos status                  the live layer, VECTOR, the lock, the animations
  bromigos anim                    every wallpaper animation and whether it's on
  bromigos anim off rain ships     turn animations off (names below, or "all")
  bromigos anim on all             turn them on
  bromigos anim reset [name …]     back to the defaults (config.toml) for those, or all
  bromigos live on|off|restart     the whole animated background (on/off are runtime)
  bromigos vector …                VECTOR (same as `vector …`: shell on, status, mute, …)
  bromigos lock                    lock the screen now
  bromigos wallpaper …             the den wallpaper (bromigos-wallpaper)

Animation switches are yours: they go in ~/.local/state/bromigos-live/overrides.toml,
merged over the dotfiles' config.toml, and the live layer applies them within ~3 s.
"""
import os
import subprocess
import sys
import tomllib

HOME = os.path.expanduser("~")
LIVE_CONF = os.path.join(HOME, ".config/bromigos-live/config.toml")
OVERRIDES = os.path.join(HOME, ".local/state/bromigos-live/overrides.toml")
LIVE = os.path.join(HOME, ".config/bromigos-live/bin/bromigos-live")
HOLO = os.path.join(HOME, ".config/bromigos/holo/bin/bromigos-holo")
WALL = os.path.join(HOME, ".config/bromigos/bin/bromigos-wallpaper")

# name -> (what it is, [(section, key), …]); one switch may set several keys
ANIMS = {
    "den":       ("the den's own screens made live (scope, burn-in monitor, meters, relay map)", [("background", "den")]),
    "streaks":   ("the left side's drifting glitch streaks", [("loops", "streaks")]),
    "rows":      ("the floor grid's rows scrolling toward you", [("loops", "rows")]),
    "rain":      ("glyph rain (density and speed follow CPU load)", [("rain", "enabled")]),
    "bursts":    ("rain columns flaring on notifications, alerts and fills", [("rain", "bursts")]),
    "pulses":    ("traffic pulses running the floor grid (follow network)", [("floor", "enabled")]),
    "sweep":     ("the X-ray scanner pass over this machine's schematic", [("sweep", "enabled")]),
    "stars":     ("parallax star layers", [("space", "stars")]),
    "ships":     ("ships and debris (density follows network traffic)", [("space", "traffic")]),
    "beam":      ("the station's beam while every lab node and service is up", [("space", "relay_beam")]),
    "tint":      ("amber/red lab-health tint on space and rain", [("space", "health_tint")]),
    "intercept": ("the burn-in sequence at login and unlock", [("events", "intercept_on_login"), ("events", "intercept_on_unlock")]),
    "flash":     ("the flash on critical notifications", [("events", "critical_flash")]),
    "wipe":      ("the wipe when switching workspaces", [("events", "workspace_wipe")]),
    "codec":     ("voiced codec calls for important events", [("codec", "enabled")]),
    "screensaver": ("the idle screensaver", [("screensaver", "enabled")]),
    "sounds":    ("the live layer's sound cues", [("sounds", "enabled")]),
}


def _load(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}


def _write_overrides(ov):
    os.makedirs(os.path.dirname(OVERRIDES), exist_ok=True)
    lines = ["# Sir's animation switches (bromigos anim …), merged over config.toml. Safe to delete.\n"]
    for sec in sorted(ov):
        if ov[sec]:
            lines.append(f"\n[{sec}]\n")
            for k in sorted(ov[sec]):
                lines.append(f"{k} = {'true' if ov[sec][k] else 'false'}\n")
    tmp = OVERRIDES + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(lines)
    os.replace(tmp, OVERRIDES)


def _state(base, ov, name):
    keys = ANIMS[name][1]
    vals = [ov.get(s, {}).get(k, base.get(s, {}).get(k, True)) for s, k in keys]
    overridden = any(k in ov.get(s, {}) for s, k in keys)
    return all(vals), overridden


def _names(args):
    if not args:
        sys.exit("name an animation (or 'all'); `bromigos anim` lists them")
    if "all" in args:
        return list(ANIMS)
    bad = [a for a in args if a not in ANIMS]
    if bad:
        sys.exit(f"unknown: {', '.join(bad)}. Known: {', '.join(ANIMS)}, all")
    return args


def anim(args):
    base, ov = _load(LIVE_CONF), _load(OVERRIDES)
    if not args:
        bg = base.get("background", {}).get("enabled", True)
        print(f"background layer: {'on' if bg else 'OFF'} (bromigos live on|off for the whole thing)\n")
        for n, (what, _) in ANIMS.items():
            on, mine = _state(base, ov, n)
            print(f"  {n:<12} {'on ' if on else 'OFF'} {'*' if mine else ' '} {what}")
        print("\n  * = your switch (bromigos anim reset … returns to the default)")
        return
    verb, names = args[0], args[1:]
    if verb in ("on", "off"):
        for n in _names(names):
            for s, k in ANIMS[n][1]:
                ov.setdefault(s, {})[k] = verb == "on"
        _write_overrides(ov)
        print(f"{verb}: {', '.join(_names(names))} (applies within a few seconds)")
    elif verb == "reset":
        for n in (_names(names) if names else list(ANIMS)):
            for s, k in ANIMS[n][1]:
                ov.get(s, {}).pop(k, None)
        _write_overrides(ov)
        print("back to the defaults" + (f": {', '.join(names)}" if names else ""))
    else:
        sys.exit("bromigos anim [on|off|reset] [name … | all]")


def run(*cmd):
    return subprocess.call(list(cmd))


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        print("\nanimations: " + ", ".join(ANIMS))
        return 0
    cmd, rest = a[0], a[1:]
    if cmd == "anim":
        anim(rest)
    elif cmd == "live":
        sub = rest[0] if rest else "status"
        if sub in ("on", "off"):          # runtime toggle of the whole background (SUPER+SHIFT+B)
            out = subprocess.run([LIVE, "status"], capture_output=True, text=True).stdout
            is_on = "background off" not in out
            if (sub == "on") != is_on:
                return run(LIVE, "toggle")
            print(f"background already {sub}")
        else:
            return run(LIVE, *rest)
    elif cmd == "vector":
        return run(HOLO, *rest)
    elif cmd == "lock":
        return run("loginctl", "lock-session")
    elif cmd == "wallpaper":
        return run(WALL, *rest)
    elif cmd == "status":
        print("── live layer"); run(LIVE, "status")
        print("\n── VECTOR")
        st = subprocess.run([HOLO, "status"], capture_output=True, text=True).stdout.strip()
        print(st[:300] if st else "not running (starts when summoned)")
        shell_off = os.path.exists(os.path.join(HOME, ".local/state/bromigos/vector-shell-off"))
        print(f"terminal: {'OFF (vector shell on)' if shell_off else 'on'}")
        print("\n── animations"); anim([])
    else:
        print(f"unknown command: {cmd}\n")
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
