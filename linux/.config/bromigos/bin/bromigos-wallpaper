#!/usr/bin/env bash
# bromigos-wallpaper — switch the den wallpaper (and its lock-screen twin).
#
#   bromigos-wallpaper den     the Wick with the operator at the desk (default)
#   bromigos-wallpaper empty   the Wick, chair empty, headphones on the desk
#   bromigos-wallpaper masked  the operator at the desk, the burn-in over his face
#   bromigos-wallpaper v1      the original den plate
#   bromigos-wallpaper status  print the active variant
#
# swaybg, hyprlock and the live layer all read the canonical paths
# bromigos-den-2560x1440.jpg / bromigos-lock-2560x1440.jpg; this script just
# repoints those symlinks, restarts swaybg on the same outputs and tells
# bromigos-live to reload its base plate.
#
# Every variant is composited onto the v1 plate, so the den rects the live
# layer draws into (CRTs, meters, floor grid) are pixel-identical across all
# variants. That is why it is safe to re-point background.den_fit_sha1 at the
# new file instead of leaving the den overlays switched off.
set -euo pipefail

WP="$HOME/.config/wallpaper"
DEN="$WP/bromigos-den-2560x1440.jpg"
LOCK="$WP/bromigos-lock-2560x1440.jpg"
LIVE_CFG="$HOME/.config/bromigos-live/config.toml"
LIVE_BIN="$HOME/.config/bromigos-live/bin/bromigos-live"

case "${1:-status}" in
    den|operator) den=bromigos-den-operator-2560x1440.jpg; lock=bromigos-lock-operator-2560x1440.jpg ;;
    empty)        den=bromigos-den-empty-2560x1440.jpg;    lock=bromigos-lock-empty-2560x1440.jpg ;;
    masked)       den=bromigos-den-masked-2560x1440.jpg;   lock=bromigos-lock-masked-2560x1440.jpg ;;
    v1)           den=bromigos-den-2560x1440-v1.jpg;       lock=bromigos-lock-2560x1440-v1.jpg ;;
    status)
        cur=$(readlink "$DEN" || echo "$DEN")
        case "$cur" in
            *operator*) name=den ;; *empty*) name=empty ;; *masked*) name=masked ;; *-v1*) name=v1 ;; *) name="?" ;;
        esac
        printf 'current: %s  (%s)\n' "$name" "$cur"
        printf 'lock:    %s\n\n' "$(readlink "$LOCK" || echo "$LOCK")"
        printf 'choices:\n'
        printf '  den     the Wick with the operator at the desk\n'
        printf '  empty   the Wick, chair empty, headphones on the desk\n'
        printf '  masked  the operator at the desk, the burn-in over his face\n'
        printf '  v1      the original den plate\n\n'
        printf 'usage: bromigos-wallpaper [den|empty|masked|v1|status]\n'
        exit 0 ;;
    -h|--help|help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: bromigos-wallpaper [den|empty|masked|v1|status]" >&2; exit 2 ;;
esac

[ -f "$WP/$den" ] || { echo "missing $WP/$den" >&2; exit 1; }
[ -f "$WP/$lock" ] || lock=""

# Refuse to clobber a real file at the canonical path (only ever replace a symlink).
for p in "$DEN" "$LOCK"; do
    if [ -e "$p" ] && [ ! -L "$p" ]; then
        echo "$p is a regular file, not a variant symlink; move it aside first" >&2
        exit 1
    fi
done

ln -sfn "$den" "$DEN"
[ -n "$lock" ] && ln -sfn "$lock" "$LOCK"

# Live layer: re-fit the den overlays to the new plate, then reload it.
if [ -f "$LIVE_CFG" ] && grep -q '^den_fit_sha1' "$LIVE_CFG"; then
    sha=$(sha1sum "$WP/$den" | cut -d' ' -f1)
    sed -i "s/^den_fit_sha1 = \"[0-9a-f]*\"/den_fit_sha1 = \"$sha\"/" "$LIVE_CFG"
fi

# swaybg: start the new instances on the same outputs, then drop the old ones (no flash).
old=$(pgrep -x swaybg || true)
outputs=$(pgrep -ax swaybg | grep -o -- '-o [^ ]*' | awk '{print $2}' | tr -d '"' | sort -u || true)
[ -n "$outputs" ] || outputs="DP-1 DP-2"
if command -v swaybg >/dev/null && { [ -n "$old" ] || ! pgrep -x hyprpaper >/dev/null; }; then
    for o in $outputs; do
        setsid -f swaybg -o "$o" -m fill -i "$DEN" >/dev/null 2>&1
    done
    sleep 0.6
    [ -n "$old" ] && kill $old 2>/dev/null || true
fi
if pgrep -x hyprpaper >/dev/null; then
    hyprctl hyprpaper reload ",$DEN" >/dev/null 2>&1 || true
fi

if [ -x "$LIVE_BIN" ]; then
    "$LIVE_BIN" ctl reload >/dev/null 2>&1 || true
fi

notify-send -a bromigos -u low "WALLPAPER" "den: ${1}" 2>/dev/null || true
echo "den -> $den${lock:+, lock -> $lock}"
