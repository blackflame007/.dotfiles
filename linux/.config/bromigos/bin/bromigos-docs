#!/usr/bin/env python3
# bromigos:summary=Keep the desktop docs' generated sections in step with the config
# bromigos:args=keys|check|…
"""Doc tooling for the Bromigos desktop: keep generated sections of the docs in step
with the config they describe, so they can't drift.

  bromigos-docs keys            rewrite the keybind table in AGENTS.md from the Hyprland config
  bromigos-docs keys --check    exit 1 if the table in AGENTS.md is out of date

The table is built by the SHORTCUTS panel's own code (widgets/keybinds.py), reading the
repo's Lua config (linux/.config/hypr/hyprland.lua and the bromigos/*.lua it requires,
run with a stand-in Hyprland by widgets/keybinds-dump.lua; not the running Hyprland), so
the result is the same on any machine. It needs `lua` (5.4 or newer). It replaces everything between the <!-- keybinds:start --> and
<!-- keybinds:end --> markers in AGENTS.md.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))               # .../linux/.config/bromigos/bin
REPO = os.path.realpath(os.path.join(HERE, "..", "..", "..", ".."))
AGENTS = os.path.join(REPO, "AGENTS.md")
CONF = os.path.join(REPO, "linux", ".config", "hypr", "hyprland.lua")
START, END = "<!-- keybinds:start -->", "<!-- keybinds:end -->"


def table():
    sys.path.insert(0, os.path.join(HERE, "..", "widgets"))
    import keybinds as K
    K._hypr_binds = lambda: None                                   # the repo's files, not the live session
    K._lua_binds.__defaults__ = (CONF,)                           # start from the repo's config
    if not K._lua_binds():
        sys.exit(f"no binds read from {CONF} (is `lua` installed?)")
    rows = ["Generated by `bromigos-docs keys` from `linux/.config/hypr/hyprland.lua` and the "
            "`bromigos/*.lua` it requires (ALT is `mainMod`; the SHORTCUTS panel shows the same list live). "
            "Do not edit by hand.", ""]
    sec = None
    for s, keys, desc, _ in K.shortcuts():
        if s != sec:
            if sec is not None:
                rows.append("")
            rows += [f"**{s}**", "", "| Keys | Action |", "|------|--------|"]
            sec = s
        rows.append(f"| {' + '.join(keys)} | {desc.replace('|', '/')} |")
    return "\n".join(rows)


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "keys":
        sys.exit(__doc__)
    with open(AGENTS) as f:
        doc = f.read()
    if START not in doc or END not in doc:
        sys.exit(f"markers {START} / {END} not found in {AGENTS}")
    head, rest = doc.split(START, 1)
    _, tail = rest.split(END, 1)
    new = f"{head}{START}\n{table()}\n{END}{tail}"
    if "--check" in sys.argv:
        if new != doc:
            print("AGENTS.md keybind table is out of date: run bromigos-docs keys", file=sys.stderr)
            sys.exit(1)
        print("keybind table up to date")
        return
    if new != doc:
        with open(AGENTS, "w") as f:
            f.write(new)
        print("AGENTS.md keybind table rewritten")
    else:
        print("keybind table already up to date")


if __name__ == "__main__":
    main()
