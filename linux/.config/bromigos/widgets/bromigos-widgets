#!/usr/bin/env python3
"""bromigos-widgets: the desktop widgets are bromigOS's package now (bromigos-widgets; its
code is bromigOS's widgets/, installed in /usr/lib/bromigos/widgets). Everything that calls
this path (Hyprland, the keybinds, VECTOR, whose build loop runs it with python3) is handed
to it. This folder keeps the operator's own layout.json; personal panels are plugins in
~/.config/bromigos/plugins/widgets/ (bromigOS docs/plugins.md)."""
import os
import sys

PKG = "/usr/bin/bromigos-widgets"
if os.path.exists(PKG):
    os.execv(PKG, ["bromigos-widgets"] + sys.argv[1:])
sys.exit("bromigos-widgets is not installed: sudo pacman -S bromigos-widgets (the [bromigos] repo)")
