#!/usr/bin/env python3
"""Bromigos desktop widgets: SYSTEM, NETWORK, STORAGE, LAB, SWITCHBOARD, FIELD NOTES.

One GTK3 process, one layer-shell surface per panel on the BOTTOM layer of the
monitor named in layout.json (above any background/live layer, below windows).

  bromigos-widgets                 run (Hyprland exec-once)
  bromigos-widgets toggle NAME     show/hide one panel (system|network|storage|lab|workbench|shortcuts|notes)
  bromigos-widgets toggle all      show/hide every panel
  bromigos-widgets notes           focus FIELD NOTES for typing (Esc hands focus back)
  bromigos-widgets reload          re-read layout.json
  bromigos-widgets stats           print draw counts and coverage to the app's stderr

Redraws pause while the active workspace on that monitor has tiled or
fullscreen windows covering the desktop; sampling continues (cheaply) so the
waterfall and scope have history when you come back.
"""
import json
import os
import signal
import socket
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "bromigos-widgets.sock")
LAYOUT = os.path.join(HERE, "layout.json")
NOTES = os.path.expanduser("~/.local/share/bromigos/notes.md")


def client(argv):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(" ".join(argv).encode(), SOCK)
    except OSError:
        sys.exit("bromigos-widgets is not running")


if len(sys.argv) > 1:
    if sys.argv[1] in ("-h", "--help", "help"):
        sys.exit(__doc__)
    client(sys.argv[1:])
    sys.exit(0)

