[Unit]
Description=Razer command dial as VECTOR's voice dial (bromigos-knob)
Documentation=file://%h/.config/bromigos/bin/bromigos-knob
After=openrazer-daemon.service

# bromigOS's keyboard module replaces this: once it's on (`bromigos peripheral enable
# razer-keyboard`), its daemon runs the dial and starting it stops this one; this one no
# longer starts at login. Then: systemctl --user disable bromigos-knob.service
Conflicts=bromigos-peripherals.service
ConditionPathExists=!%h/.local/state/bromigos/peripherals/hypr.lua

[Service]
ExecStart=/usr/bin/python3 %h/.config/bromigos/bin/bromigos-knob
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
