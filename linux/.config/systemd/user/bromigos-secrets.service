[Unit]
Description=Refresh the desktop's secret files (~/.local/share/bromigos) from Vault
Documentation=file://%h/.config/bromigos/bin/bromigos-secrets
After=bromigos-private.service network-online.target
Wants=bromigos-private.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.config/bromigos/bin/bromigos-secrets sync --quiet
Nice=10

[Install]
WantedBy=default.target
