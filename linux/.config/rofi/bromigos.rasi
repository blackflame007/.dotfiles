/* Bromigos launcher: panel background, 1px phosphor rules, square corners,
   the burn-in in the header, a "> " prompt with a blinking block cursor.
   Labels name real things only: the mode tabs and the live match count. */
* {
    void:      #000500;
    panel:     #001300;
    guard:     #003b00;
    phosphor:  #39ff14;
    soft:      #9cff8a;
    dim:       #159b09;
    amber:     #d4af37;
    danger:    #ff766f;
    static:    #7e927e;

    font: "Geist Mono Medium 13";
    background-color: transparent;
    text-color: @soft;
    border-color: @dim;
    border-radius: 0;
    spacing: 0;
}

window {
    width: 780px;
    location: center;
    anchor: center;
    background-color: @panel;
    border: 1px;
    border-color: @dim;
    padding: 0;
}

mainbox {
    children: [ box-header, listview, box-footer ];
    spacing: 0;
}

box-header {
    orientation: horizontal;
    expand: false;
    children: [ icon-emblem, box-headerbody ];
    padding: 18px 20px 14px 18px;
    spacing: 18px;
    border: 0 0 1px 0;
    border-color: @dim;
}

icon-emblem {
    expand: false;
    size: 88px;
    filename: "~/.config/bromigos/brand/emblem-256.png";
    vertical-align: 0.5;
}

box-headerbody {
    orientation: vertical;
    vertical-align: 0.5;
    children: [ mode-switcher, inputbar ];
    spacing: 14px;
    expand: true;
}

mode-switcher {
    spacing: 0;
    expand: false;
}
button {
    padding: 4px 14px;
    text-color: @static;
    font: "Geist Mono SemiBold 11";
    border: 0 0 2px 0;
    border-color: transparent;
    horizontal-align: 0.5;
}
button selected {
    text-color: @phosphor;
    border-color: @phosphor;
    background-color: #39ff1414;
}

inputbar {
    children: [ textbox-prompt, entry, num-filtered-rows, textbox-num-sep, num-rows ];
    spacing: 0;
    padding: 8px 10px;
    background-color: #000500cc;
    border: 1px;
    border-color: #159b0999;
}
textbox-prompt {
    str: "> ";
    expand: false;
    text-color: @phosphor;
    font: "Geist Mono Bold 16";
}
entry {
    text-color: @soft;
    font: "Geist Mono Medium 16";
    placeholder: "";
    cursor: text;
    cursor-width: 10px;
    cursor-color: @phosphor;
    blink: true;
}
num-filtered-rows, textbox-num-sep, num-rows {
    text-color: @static;
    font: "Geist Mono 11";
    vertical-align: 0.5;
    expand: false;
}
textbox-num-sep {
    str: "/";
}

listview {
    lines: 9;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    padding: 8px 10px;
    spacing: 2px;
}

element {
    padding: 7px 12px;
    spacing: 14px;
    border: 0 0 0 2px;
    border-color: transparent;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
}
element selected.normal {
    background-color: @phosphor;
    border-color: @soft;
    text-color: @void;
}
element normal.urgent, element alternate.urgent {
    text-color: @amber;
}
element selected.urgent {
    background-color: @amber;
}
element normal.active, element alternate.active {
    text-color: @phosphor;
}
element-icon {
    size: 24px;
    vertical-align: 0.5;
}
element-text {
    vertical-align: 0.5;
    text-color: inherit;
    /* matched letters: bright phosphor + underline on the dark rows... */
    highlight: bold underline #39ff14;
}
/* ...and void-dark on the selected row, whose background is phosphor (green on green
   made the match invisible). */
element-text selected, element-text selected.normal, element-text selected.active {
    highlight: bold underline #000500;
}
element-text selected.urgent {
    highlight: bold underline #000500;
}

box-footer {
    orientation: horizontal;
    children: [ message ];
    expand: false;
}
message {
    padding: 8px 20px;
    border: 1px 0 0 0;
    border-color: @dim;
}
textbox {
    text-color: @static;
    font: "Geist Mono 11";
}
error-message {
    background-color: @panel;
    border: 1px;
    border-color: @danger;
    padding: 12px;
}
