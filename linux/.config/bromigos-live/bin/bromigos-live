#!/usr/bin/env bash
# bromigos:summary=The animated live layer: start/stop, decks, toggles
# bromigos:args=start|stop|restart|status|<deck> …
# bromigos-live — the animated, data-reactive live layer.
#
#   bromigos-live start [--login]  start the daemon (supervised; no-op if running)
#   bromigos-live stop | restart
#   bromigos-live toggle           background layer on/off
#   bromigos-live mute             sounds on/off (works without the daemon)
#   bromigos-live holodeck | arbiter | driftmap | timeline [open|close]   a deck: toggle, or open/close
#   bromigos-live radial | intercept | screensaver | screensaver-off
#   bromigos-live scan             run a scanner pass now (hardware schematic)
#   bromigos-live scan-pin         pin / unpin the schematic (stays up, live values)
#   bromigos-live scan-hold on|off hold-to-scan (bound to press / release)
#   bromigos-live codec "text" [FLOOR|LAB|DECK|PRIORITY]   a codec call (rate-limited)
#   bromigos-live codec-quiet      codec calls without voice (toggle)
#   bromigos-live job -- cmd ...   run cmd; a long run ends with a codec call
#   bromigos-live mind|ops|swarm|netmap|replay [verb args]   VECTOR's holograms (see the hologram-build skill)
#   bromigos-live plugin <name> [verb args]   a deck plugin from plugins/ (see live/plugins.py)
#   bromigos-live world [verb …]   the theme's world: state, event notify|critical|fill win|lab_alert,
#                                  set <signal> <value> (hold one, to try it), clear, rollcall
#   bromigos-live ctl <cmd>        raw control command (burst, transmission, reload, state, theme, activity idle|active)
#   bromigos-live status
# bromigOS packages the live layer (bromigos-live, /usr/bin; docs/plugins.md in bromigOS):
# when it's installed this copy hands over to it. BROMIGOS_LIVE_FROM_DOTFILES=1 runs this one.
if [ -x /usr/bin/bromigos-live ] && [ -z "${BROMIGOS_LIVE_FROM_DOTFILES:-}" ]; then
    exec /usr/bin/bromigos-live "$@"
fi
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK="$RUN/bromigos-live.sock"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/bromigos-live"
LOG="$STATE/live.log"
PIDF="$RUN/bromigos-live.pid"
PY=/usr/bin/python3
mkdir -p "$STATE"

ctl() {
    "$PY" - "$SOCK" "$*" <<'EOF'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(4)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(3)
s.sendall(sys.argv[2].encode())
chunks = []
while True:                      # the daemon closes after its reply; status replies exceed one recv
    try:
        b = s.recv(65536)
    except socket.timeout:
        break
    if not b:
        break
    chunks.append(b)
print(b"".join(chunks).decode(errors="replace"))
EOF
}

running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

# The Hyprland session the running daemon was started for (its environment at start).
daemon_sig() {
    local c
    c=$(pgrep -P "$(cat "$PIDF" 2>/dev/null)" -f "live.app" 2>/dev/null | head -1)
    [ -n "$c" ] && tr '\0' '\n' <"/proc/$c/environ" 2>/dev/null | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p'
}
SESSION_ENV="$HOME/.config/bromigos/bin/bromigos-session-env"

supervise() {
    # Restart on crash, but give up after 4 crashes inside 2 minutes: no crash loops.
    local first="--login"; [ "${1:-}" = "--login" ] || first=""
    local fails=() now
    while :; do
        # every (re)start goes to the session that is actually alive: its instance AND its
        # Wayland socket (a restart after a re-login used to keep the dead session's
        # WAYLAND_DISPLAY and draw nowhere). bromigos-session-env reads hypr/*/hyprland.lock.
        if [ -x "$SESSION_ENV" ] && live_env=$("$SESSION_ENV" 2>/dev/null); then
            eval "$(printf '%s\n' "$live_env" | sed 's/^/export /')"
        elif ! HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-}" /usr/bin/hyprctl version >/dev/null 2>&1; then
            for s in $(ls -t "$RUN/hypr" 2>/dev/null); do
                if HYPRLAND_INSTANCE_SIGNATURE="$s" /usr/bin/hyprctl version >/dev/null 2>&1; then
                    HYPRLAND_INSTANCE_SIGNATURE="$s"; break
                fi
            done
            export HYPRLAND_INSTANCE_SIGNATURE
        fi
        cd "$HERE" && "$PY" -m live.app $first >>"$LOG" 2>&1
        rc=$?
        first=""
        [ $rc -eq 0 ] && break                       # clean quit (stop)
        [ -f "$STATE/stopping" ] && break
        # rc 3: the daemon waited ~60 s for a display and found none. With no Wayland
        # socket left the session is over: stop rather than loop.
        if [ $rc -eq 3 ] && ! compgen -G "$RUN/wayland-*" >/dev/null; then
            echo "$(date -Is) no Wayland session; supervisor stopping" >>"$LOG"
            break
        fi
        now=$(date +%s)
        fails+=("$now")
        local recent=()
        for t in "${fails[@]}"; do [ $((now - t)) -lt 120 ] && recent+=("$t"); done
        fails=("${recent[@]}")
        echo "$(date -Is) daemon exited rc=$rc (${#fails[@]} recent)" >>"$LOG"
        if [ ${#fails[@]} -ge 4 ]; then
            echo "$(date -Is) giving up: crash loop" >>"$LOG"
            notify-send -a bromigos-live -u low "LIVE LAYER OFFLINE" "Crashed 4x in 2 min. Log: $LOG" 2>/dev/null
            break
        fi
        sleep 2
    done
    rm -f "$PIDF"
}

case "${1:-start}" in
    start)
        if running; then
            # running, but for another (dead) session, e.g. a re-login: move it to this one
            if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ "$(daemon_sig)" != "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
                echo "running for another session; moving it to this one"
                "$0" stop >/dev/null 2>&1
            else
                echo "already running"; exit 0
            fi
        fi
        rm -f "$STATE/stopping"
        # keep the log small
        [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 1000000 ] && mv "$LOG" "$LOG.1"
        ( supervise "${2:-}" ) </dev/null >/dev/null 2>&1 &
        echo $! >"$PIDF"
        disown
        ;;
    stop)
        touch "$STATE/stopping"
        ctl quit >/dev/null 2>&1
        sleep 0.5
        if running; then pkill -P "$(cat "$PIDF")" 2>/dev/null; kill "$(cat "$PIDF")" 2>/dev/null; fi
        pkill -f "^/usr/bin/python3 -m live.app" 2>/dev/null   # anchored: only the daemon, never a command line that mentions it
        rm -f "$PIDF"
        ;;
    restart) "$0" stop; sleep 0.5; "$0" start ;;
    mute)
        out=$(ctl mute 2>/dev/null) || {
            if [ -f "$STATE/muted" ]; then rm -f "$STATE/muted"; out=unmuted; else touch "$STATE/muted"; out=muted; fi
        }
        notify-send -a bromigos-live -u low -t 1200 "SOUND ${out^^}" 2>/dev/null
        echo "$out"
        ;;
    holodeck|arbiter|driftmap|timeline)
        # no argument toggles (the keys); "open" / "close" are explicit (VECTOR's tour)
        ctl "$1${2:+ $2}" || { echo "not running (bromigos-live start)"; exit 1; } ;;
    toggle|radial|intercept|screensaver|screensaver-off)
        ctl "$1" || { [ "$1" = screensaver-off ] || echo "not running (bromigos-live start)"; exit 1; } ;;
    scan|scan-pin) ctl "$1" ;;
    plugin)
        # a deck plugin (plugins/<name>.py): bromigos-live plugin <name> [verb args]
        shift; ctl "plugin $*" ;;
    mind|ops|swarm|netmap|replay)
        # open a hologram, or drive it: bromigos-live mind focus kb-sync, netmap trace nas, ...
        kind="$1"; shift; ctl "deck $kind $*" ;;
    codec) shift; text="${1:-}"; ch="${2:-DECK}"; ctl "codec $ch|$text" ;;
    codec-quiet)
        out=$(ctl codec-quiet 2>/dev/null) || out="not running"
        notify-send -a bromigos-live -u low -t 1400 "CODEC" "$out" 2>/dev/null; echo "$out" ;;
    job)
        # run a command; if it took long enough, the deck calls in when it ends
        shift; [ "${1:-}" = "--" ] && shift
        [ $# -gt 0 ] || { echo "usage: bromigos-live job -- cmd [args]"; exit 2; }
        min=$("$PY" -c 'import tomllib,os,sys
try: print(int(tomllib.load(open(os.path.expanduser("~/.config/bromigos-live/config.toml"),"rb")).get("codec",{}).get("job_min_seconds",60)))
except Exception: print(60)')
        t0=$(date +%s); "$@"; rc=$?; dur=$(( $(date +%s) - t0 ))
        if [ "$dur" -ge "$min" ]; then
            name=$(basename -- "$1"); m=$((dur / 60)); sec=$((dur % 60))
            if [ $rc -eq 0 ]; then how="clean"; else how="with exit code $rc"; fi
            ctl "codec DECK|Deck here. $name finished $how after $m minutes $sec seconds." >/dev/null 2>&1 || true
        fi
        exit $rc ;;
    scan-hold) ctl "scan-hold ${2:-on}" ;;
    ctl) shift; ctl "$*" ;;
    world) shift; ctl "world $*" || { echo "not running (bromigos-live start)"; exit 1; } ;;
    status)
        if running; then echo "daemon up (supervisor $(cat "$PIDF"))"; ctl state; else echo "stopped"; fi
        [ -f "$STATE/muted" ] && echo "sounds: muted" || echo "sounds: on"
        ;;
    *) sed -n '2,12p' "$0"; exit 2 ;;
esac
