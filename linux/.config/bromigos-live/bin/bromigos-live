#!/usr/bin/env bash
# bromigos:summary=The animated live layer: start/stop, decks, toggles
# bromigos:args=start|stop|restart|status|<deck> …
# bromigos-live: the live layer is bromigOS's package now (bromigos-live; its code is
# bromigOS's live/, installed in /usr/lib/bromigos/live). Everything that calls this path
# (Hyprland, the keybinds, waybar, VECTOR, bromigos-wallpaper) is handed to it.
# This folder keeps the operator's own config.toml; personal decks are plugins in
# ~/.config/bromigos/plugins/live/ (bromigOS docs/plugins.md).
if [ -x /usr/bin/bromigos-live ]; then exec /usr/bin/bromigos-live "$@"; fi
echo "bromigos-live is not installed: sudo pacman -S bromigos-live (the [bromigos] repo)" >&2
exit 127
