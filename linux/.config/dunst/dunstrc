# Bromigos notifications: panel background, 1px phosphor rule, square corners.
# Title line = the sending app in uppercase, wide-tracked; then summary, then body.
# Critical = danger red. Notices that arrive without their own icon (system and
# script notices) carry the burn-in dial as a small "transmission" mark.
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (16, 16)
    width = (300, 440)
    height = (0, 300)
    notification_limit = 6
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14
    frame_width = 1
    frame_color = "#39ff14"
    separator_color = frame
    separator_height = 1
    corner_radius = 0
    transparency = 0
    sort = yes
    idle_threshold = 120
    indicate_hidden = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 412
    progress_bar_corner_radius = 0
    highlight = "#39ff14"

    font = Geist Mono 11
    line_height = 2
    markup = full
    format = "<span text_transform='uppercase' letter_spacing='1800' size='small' weight='600' foreground='#159b09'>%a</span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 0
    default_icon = ~/.config/bromigos/brand/emblem-small-64.png
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    layer = overlay

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#001300"
    foreground = "#7e927e"
    frame_color = "#159b09"
    highlight = "#159b09"
    timeout = 5

[urgency_normal]
    background = "#001300"
    foreground = "#9cff8a"
    frame_color = "#39ff14"
    timeout = 8

[urgency_critical]
    background = "#1a0503"
    foreground = "#ffd9d6"
    frame_color = "#ff766f"
    highlight = "#ff766f"
    format = "<span text_transform='uppercase' letter_spacing='1800' size='small' weight='700' foreground='#ff766f'>%a · critical</span>\n<b>%s</b>\n%b"
    timeout = 0
