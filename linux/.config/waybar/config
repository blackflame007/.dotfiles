{
  // My bar: bromigOS's (first include, package bromigos-desktop) and the theme's markup
  // colours (second, rendered by `bromigos theme set`), merged under this file: what's
  // set here wins, object by object.
  "include": [
    "/usr/share/bromigos/default/waybar/config.jsonc",
    "~/.local/state/bromigos/theme/current/waybar-markup.jsonc"
  ],
  "output": ["DP-1", "DP-2"],

  // CPU package temperature: k10temp's Tctl on this board
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "tooltip-format": "CPU package (k10temp Tctl) {temperatureC} °C\namber 80 °C · red 90 °C"
  }
}
