{
  // Bromigos HUD. Every module is a real reading or an action; hover any of
  // them for what it is. Scripts live in ~/.config/waybar/scripts.
  // The markup colours (mpris, network, the calendar) come from the theme in force:
  // `bromigos theme set` renders them here, and they merge into the modules below.
  "include": ["~/.local/state/bromigos/theme/current/waybar-markup.jsonc"],
  "layer": "bottom",
  "position": "top",
  "output": ["DP-1", "DP-2"],
  "height": 34,
  "spacing": 0,
  "modules-left": ["custom/launcher", "ext/workspaces", "hyprland/window"],
  "modules-center": ["mpris"],
  "modules-right": ["custom/vector", "cpu", "memory", "custom/gpu", "temperature", "custom/storage", "network",
                    "pulseaudio", "tray", "clock"],

  "custom/launcher": {
    "format": " ",
    "tooltip-format": "Launcher: apps (click) · run a command (right-click) · power menu (middle-click)",
    "on-click": "rofi -show drun",
    "on-click-right": "rofi -show run",
    "on-click-middle": "~/.config/rofi/scripts/power-menu"
  },

  // ext/workspaces (the Wayland ext-workspace protocol), not hyprland/workspaces: a click
  // there sends Hyprland "dispatch workspace N", which the Lua config (0.56) reads as Lua
  // and rejects, so clicking a workspace did nothing. The protocol switches it directly.
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": true,
    "tooltip": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": { "": "" },
    "tooltip": true
  },

  "mpris": {
    "format-stopped": "",
    "max-length": 70,
    "interval": 1,
    "tooltip-format": "{player}: {status}\n{artist} — {album}\n{title}\nclick: play/pause · right-click: next · scroll: seek",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },

  "cpu": {
    "interval": 2,
    "format": "{usage:>2}%",
    "tooltip": true,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 4,
    "format": "{percentage:>2}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB used, {avail:0.1f} GiB available\nswap {swapUsed:0.1f} / {swapTotal:0.1f} GiB\namber 75% · red 90% · click: btop",
    "states": { "warning": 75, "critical": 90 },
    "on-click": "kitty -e btop"
  },

  "custom/vector": {
    "exec": "~/.config/waybar/scripts/vector.py",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/.config/bromigos/holo/bin/bromigos-holo vector",
    "on-click-right": "~/.config/bromigos/holo/bin/bromigos-holo voice cycle",
    "on-click-middle": "~/.config/bromigos/holo/bin/bromigos-holo mute"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.py",
    "return-type": "json",
    "restart-interval": 10,
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 4,
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{temperatureC}°",
    "tooltip-format": "CPU package (k10temp Tctl) {temperatureC} °C\namber 80 °C · red 90 °C"
  },

  "custom/storage": {
    "exec": "~/.config/waybar/scripts/storage.py",
    "return-type": "json",
    "interval": 60,
    "on-click": "xdg-open ~"
  },

  "network": {
    "interval": 2,
    "format-linked": "{ifname} NO ADDRESS",
    "format-disconnected": "DISCONNECTED",
    "tooltip-format-wifi": "{ifname} · {essid} · {signalStrength}% ({signaldBm} dBm)\naddress {ipaddr}/{cidr} via {gwaddr}\nclick: copy the address",
    "tooltip-format-ethernet": "{ifname}\naddress {ipaddr}/{cidr} via {gwaddr}\nclick: copy the address",
    "tooltip-format-disconnected": "No network link",
    "on-click": "~/.config/waybar/scripts/copy-ip",
    "on-click-right": "kitty -e nmtui"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{volume:>2}%",
    "format-muted": "MUTED",
    "format-bluetooth": "{volume:>2}% BT",
    "tooltip-format": "{desc}: {volume}%\nclick: mixer · right-click: mute · scroll: ±5%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1
    },
    "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  }
}
