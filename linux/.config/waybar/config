{
  // Bromigos HUD. Every module is a real reading or an action; hover any of
  // them for what it is. Scripts live in ~/.config/waybar/scripts.
  "layer": "bottom",
  "position": "top",
  "output": ["DP-1", "DP-2"],
  "height": 34,
  "spacing": 0,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["mpris"],
  "modules-right": ["cpu", "memory", "custom/gpu", "temperature", "custom/storage", "network",
                    "pulseaudio", "tray", "clock"],

  "custom/launcher": {
    "format": " ",
    "tooltip-format": "Launcher: apps (click) · run a command (right-click) · power menu (middle-click)",
    "on-click": "rofi -show drun",
    "on-click-right": "rofi -show run",
    "on-click-middle": "~/.config/rofi/scripts/power-menu"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "tooltip": true,
    "persistent-workspaces": { "DP-1": [1, 2, 3, 4, 5, 6] }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": { "": "" },
    "tooltip": true
  },

  "mpris": {
    "format": "{artist} · {title}  <span color='#7e927e'>{position}/{length}</span>",
    "format-paused": "<span color='#7e927e'>‖</span> {artist} · {title}",
    "format-stopped": "",
    "max-length": 70,
    "interval": 1,
    "tooltip-format": "{player}: {status}\n{artist} — {album}\n{title}\nclick: play/pause · right-click: next · scroll: seek",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },

  "cpu": {
    "interval": 2,
    "format": "{usage:>2}%",
    "tooltip": true,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 4,
    "format": "{percentage:>2}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB used, {avail:0.1f} GiB available\nswap {swapUsed:0.1f} / {swapTotal:0.1f} GiB\namber 75% · red 90% · click: btop",
    "states": { "warning": 75, "critical": 90 },
    "on-click": "kitty -e btop"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.py",
    "return-type": "json",
    "restart-interval": 10,
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 4,
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{temperatureC}°",
    "tooltip-format": "CPU package (k10temp Tctl) {temperatureC} °C\namber 80 °C · red 90 °C"
  },

  "custom/storage": {
    "exec": "~/.config/waybar/scripts/storage.py",
    "return-type": "json",
    "interval": 60,
    "on-click": "xdg-open ~"
  },

  "network": {
    "interval": 2,
    "format-wifi": "<span color='#7e927e'>⇣</span>{bandwidthDownBytes:>8} <span color='#7e927e'>⇡</span>{bandwidthUpBytes:>8}",
    "format-ethernet": "<span color='#7e927e'>⇣</span>{bandwidthDownBytes:>8} <span color='#7e927e'>⇡</span>{bandwidthUpBytes:>8}",
    "format-linked": "{ifname} NO ADDRESS",
    "format-disconnected": "DISCONNECTED",
    "tooltip-format-wifi": "{ifname} · {essid} · {signalStrength}% ({signaldBm} dBm)\naddress {ipaddr}/{cidr} via {gwaddr}\nclick: copy the address",
    "tooltip-format-ethernet": "{ifname}\naddress {ipaddr}/{cidr} via {gwaddr}\nclick: copy the address",
    "tooltip-format-disconnected": "No network link",
    "on-click": "~/.config/waybar/scripts/copy-ip",
    "on-click-right": "kitty -e nmtui"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{volume:>2}%",
    "format-muted": "MUTED",
    "format-bluetooth": "{volume:>2}% BT",
    "tooltip-format": "{desc}: {volume}%\nclick: mixer · right-click: mute · scroll: ±5%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#39ff14'><b>{}</b></span>",
        "weeks": "<span color='#159b09'>{}</span>",
        "weekdays": "<span color='#7e927e'>{}</span>",
        "days": "<span color='#9cff8a'>{}</span>",
        "today": "<span background='#39ff14' color='#000500'><b>{}</b></span>"
      }
    },
    "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  }
}
