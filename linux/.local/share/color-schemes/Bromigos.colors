# Bromigos colour scheme for KDE/Qt apps (Dolphin, Kate, Okular, file dialogs).
# Palette tokens: void #000500, panel #001300, guard #003b00, phosphor #39ff14,
# phosphor-soft #9cff8a, phosphor-dim #159b09, amber #d4af37, danger #ff766f,
# static #7e927e. Apply: plasma-apply-colorscheme Bromigos (writes kdeglobals).

[General]
ColorScheme=Bromigos
Name=Bromigos
shadeSortColumn=true

[KDE]
contrast=6

[ColorEffects:Disabled]
Color=0,19,0
ColorAmount=0.55
ColorEffect=3
ContrastAmount=0.55
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

