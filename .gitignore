# bromigOS user files under ~/.config/bromigos (a stow link into this public repo) are
# tracked here, except the profile: its personal details live encrypted in private.sops.yaml
# (operator:), and bromigos-private writes this plaintext copy at login.
linux/.config/bromigos/profile.toml
