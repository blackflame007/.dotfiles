# Bromigos shell theme: mehshell's prompt in the Bromigos colours, then bromigOS's shell
# defaults (the login banner, zoxide). Sourced from .zshrc after zsh-mehshell
# (zsh_add_file "zsh-bromigos").
#
#   bromigos banner     print the banner (emblem + live system lines)
#   BROMIGOS_BANNER     login (default: interactive login shells only)
#                       always (every interactive shell) | off
#   BROMIGOS_PROMPT=off keep mehshell's own colours

# ---------------------------------------------------------------- prompt
# mehshell emits fixed 256-colour indexes (render.go: cCyan 75, cBlue 39,
# cMagenta 170, cGreen 76, cRed 196, cYellow 220, cOrange 208, cGray 242,
# separators 246/238). A precmd hook that runs after mehshell's swaps them for
# the Bromigos palette in 24-bit colour. String substitution only, no forks.
typeset -gA _bromigos_prompt_map=(
  75  '#159b09'   # frame ╭─ ╰─        -> phosphor-dim
  39  '#39ff14'   # os icon, directory -> phosphor
  170 '#3fe0c5'   # git branch         -> cyan (terminal palette)
  76  '#39ff14'   # prompt char, ok    -> phosphor
  196 '#ff766f'   # dirty, errors      -> danger
  220 '#d4af37'   # untracked, warn    -> amber
  208 '#f0d36a'   # orange             -> bright amber
  242 '#7e927e'   # time, muted        -> static
  246 '#4e6b4e'   # thin separators
  238 '#003b00'   # segment fill       -> guard
)

_bromigos_prompt_colors() {
  [[ $BROMIGOS_PROMPT == off ]] && return
  local k p=$PROMPT
  for k in ${(k)_bromigos_prompt_map}; do
    p=${p//\%F\{$k\}/%F\{${_bromigos_prompt_map[$k]}\}}
    p=${p//\%K\{$k\}/%K\{${_bromigos_prompt_map[$k]}\}}
  done
  PROMPT=$p
}

# Only where 24-bit colour works (kitty, alacritty); a Linux VT keeps mehshell's.
if [[ $COLORTERM == (truecolor|24bit) || $TERM == (xterm-kitty|alacritty) ]]; then
  precmd_functions+=(_bromigos_prompt_colors)
fi

# ---------------------------------------------------------------- bromigOS
# The login banner and zoxide: bromigOS's shell defaults (package bromigos-desktop).
[[ -r /usr/share/bromigos/default/zsh/bromigos.zsh ]] && source /usr/share/bromigos/default/zsh/bromigos.zsh
